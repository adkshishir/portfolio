# Public site URL, used to build absolute URLs (metadata, sitemap, robots.txt).
NEXT_PUBLIC_FRONTEND_BASE_URL=https://adhikarishishir.com.np

# --- Contact form email (lib/mail.ts, app/api/contact/send) ---
# SMTP host/port for the account the contact form sends from.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=you@example.com
MAIL_PASSWORD=
# Optional: defaults to MAIL_USER if unset.
MAIL_FROM=you@example.com

# --- WhatsApp Business Cloud API (lib/whatsapp.ts, app/api/whatsapp/*) ---
# Not currently used by the contact form (it now sends email), but the
# webhook/send routes still depend on these if you keep that integration.
PHONE_NUMBER_ID=
ACCESS_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_NUMBER=
WHATSAPP_NAME=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_DEFAULT_COUNTRY_CODE=
